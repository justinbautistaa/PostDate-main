# Copy to backend/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/postdate
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Resend API key and a sender on your verified domain. Server-side only.
MAIL_MODE=resend
MAIL_API_KEY=
MAIL_FROM=
# Optional Gmail delivery: set MAIL_MODE=gmail and fill both values below.
# GMAIL_APP_PASSWORD must be a Gmail app password for GMAIL_USER, not the account's normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# HTTPS delivery on Render Free: MAIL_MODE=gmail-api. Authorize only your sender
# with https://www.googleapis.com/auth/gmail.send and offline access.
# GMAIL_USER must be that same authorized Gmail mailbox. See GMAIL_API_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Behind a reverse proxy, list only the actual trusted proxy IPs/CIDRs.
TRUST_PROXY=
# Cloudinary is required for ephemeral hosts such as Render's free preview.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional encrypted backup tooling: generate 32 random bytes as 64 hex digits.
BACKUP_ENCRYPTION_KEY=
# Distinct empty restore_test database, used only for recovery drills.
POSTDATE_RESTORE_TEST_URI=
# Optional browser push. Generate once with scripts/setupPush.js using your HTTPS URL.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for authenticator enrollment. Generate 32 random bytes as 64 hex digits.
# Keep stable and back up separately; changing it makes existing MFA secrets unreadable.
MFA_ENCRYPTION_KEY=
